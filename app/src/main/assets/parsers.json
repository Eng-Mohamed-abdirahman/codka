{
  "version": 1,
  "_about": "Zaad / eDahab payment SMS formats (task 10). When a provider changes its wording, update the pattern here and add the new SMS to app/src/test/resources/sms-samples. Each pattern has 3 groups: (1) amount, (2) sender name, (3) sender phone.",
  "formats": [
    {
      "id": "zaad-usd",
      "provider": "ZAAD",
      "currency": "USD",
      "marker": "[-[--ZAAD SERVICES--]-]",
      "pattern": "Waxaad \\$([0-9][0-9,]*(?:\\.[0-9]+)?) ka heshay\\s+(.+?)\\s*\\((\\d+)\\)"
    },
    {
      "id": "zaad-slsh",
      "provider": "ZAAD",
      "currency": "SLSH",
      "marker": "[-[--ZAAD SHILLING--]-]",
      "pattern": "Waxaad SLSH([0-9][0-9,]*(?:\\.[0-9]+)?) ka heshay\\s+(.+?)\\s*\\((\\d+)\\)"
    },
    {
      "id": "edahab-usd",
      "provider": "EDAHAB",
      "currency": "USD",
      "marker": "[eDahab Service-Dollar]",
      "pattern": "^\\s*([0-9][0-9,]*(?:\\.[0-9]+)?) Dollar Ayaad ka Heshay\\s+(.+?)\\s*\\((\\d+)\\)"
    },
    {
      "id": "edahab-slsh",
      "provider": "EDAHAB",
      "currency": "SLSH",
      "marker": "[eDahab Service-Shilling]",
      "pattern": "^\\s*([0-9][0-9,]*(?:\\.[0-9]+)?) Shilling Ayaad ka Heshay\\s+(.+?)\\s*\\((\\d+)\\)"
    }
  ]
}
